{
  "exe": "<path>/build/strata",
  "cwd": "<path>",
  "args": [
    "--serve",
    "--pack",
    "<path>/packs/iq3_s",
    "--native",
    "<path>/models/<model>-00001-of-00002.gguf",
    "--ple-gguf",
    "<path>/models/<model>-00002-of-00002.gguf",
    "--mmap-experts",
    "--expert-profile",
    "data/expert-profile-iq3s-learned.bin",
    "--expert-cache",
    "11240",
    "--prefill",
    "auto:16384",
    "--spec",
    "4",
    "--spec-min-p",
    "0.7",
    "--mtp",
    "<path>/mtp/rt",
    "--max-context",
    "204800",
    "--kv",
    "q4_0",
    "--pool-workers",
    "5",
    "--adapt-every",
    "4",
    "--pcie-frac",
    "0.3",
    "--vram-reserve-mib",
    "1024",
    "--vram-reserve-later-mib",
    "822",
    "--prompt-cache",
    "24",
    "--conversation-cache-mib",
    "40960",
    "--conversation-cache-slots",
    "24",
    "--conversation-cache-min-tokens",
    "4096",
    "--kv-resident",
    "20480",
    "--conversation-cache-min-free-mib",
    "12288",
    "--conversation-cache-park-gain",
    "8192",
    "--short-read",
    "256",
    "--prompt-cache-every",
    "4096",
    "--pipeline-windows",
    "2",
    "--trim-stage-weights"
  ],
  "tokenizer": "<path>/packs/iq3_s/tokenizer",
  "model_name": "qwen3.8-flash-next-iq3_s",
  "backend": "hip",
  "host": "0.0.0.0",
  "port": "<port>",
  "gpu": [
    0,
    1
  ],
  "layer_split": 26,
  "expert_profile_save": "data/expert-profile-iq3s-148.bin",
  "expert_profile_save_every": 0,
  "parallel": 1,
  "env": {
    "STRATA_MANIFEST": "<path>/manifest-slots24.json",
    "STRATA_PARK_TRACE": "1",
    "STRATA_HIP_PROMPT_F16": "1",
    "STRATA_ROCBLAS_TUNING": "<path>/tools/hip",
    "STRATA_STAGE_TRIM": "1",
    "STRATA_SPLIT_COVER_B": "3",
    "STRATA_SPLIT_LINK_ABS": "1",
    "STRATA_SLOT_COPY_DIRECT": "1",
    "STRATA_SLOT_COPY_BATCHSYNC": "1",
    "STRATA_PREFILL_RING": "384",
    "STRATA_IO_PREFETCH": "0",
    "STRATA_PREFILL_CPU_SHARE": "auto",
    "HSA_DISABLE_COREDUMP_ON_EXCEPTION": "1",
    "STRATA_CKPT_BODY_AT": "2",
    "STRATA_VERIFY_TIMEOUT_S": "90",
    "STRATA_WATCHDOG_S": "600",
    "STRATA_WATCHDOG_IO_S": "900",
    "STRATA_SELECT_SIMT": "1",
    "STRATA_GR_R2": "1",
    "STRATA_CKPT_POOL": "1",
    "STRATA_CKPT_POOL_READY": "4",
    "STRATA_SLOT_CKPT_MOVE": "1",
    "STRATA_BATCH_GDN_GROUPS": "1",
    "STRATA_BATCH_ATTN_ROWS": "1",
    "STRATA_BATCH_SELF_COMMIT": "0",
    "STRATA_QSA_SLOTS": "1",
    "STRATA_PIPED_MTP": "1",
    "STRATA_PIPED_CONCURRENT": "1",
    "STRATA_SPLIT_MTP_BATCH": "1",
    "STRATA_EXP_GU_H2": "1",
    "STRATA_EXP_LDS_Q50": "1",
    "STRATA_EXP_X4": "1",
    "STRATA_GR_DOWN_PF": "1",
    "STRATA_GR_DOWN_TG": "a",
    "STRATA_HIP_SWIGLU_FUSED": "1",
    "STRATA_IQ_MMVQ_R2": "1",
    "STRATA_IQ_MMVQ_RB": "16",
    "STRATA_IQ_MMVQ_XLDS": "1",
    "STRATA_IQ_STAGE_GRID_MMVQ": "1",
    "STRATA_MMVF_ROWS": "1",
    "STRATA_MMVQ_Q4X4": "1",
    "STRATA_MMVQ_Q6X4": "1",
    "STRATA_MMVQ_WPB": "8",
    "STRATA_MMVQ_XLDS": "1",
    "STRATA_DECODE_TIMING": "1"
  },
  "log": "<path>/strata-engine.log",
  "allowed_hosts": [
    "127.0.0.1",
    "localhost"
  ],
  "fit_max_tokens": true,
  "vision": {
    "exe": "<path>/vision/bin/strata-vision",
    "mmproj": "<path>/vision/mmproj-BF16.gguf",
    "model": "<path>/models/<model>-00001-of-00002.gguf",
    "threads": 8,
    "max_tokens": 1024
  },
  "max_queue": 4,
  "engine_silence_s": 60,
  "queue_timeout": 600
}
